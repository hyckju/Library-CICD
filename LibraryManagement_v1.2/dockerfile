# docker build -t library-management-v1_2 .

# 1단계: 빌드 스테이지 - Maven으로 jar 패키징
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# 의존성 캐시 최적화: pom.xml만 먼저 복사
COPY pom.xml .
RUN mvn -B dependency:go-offline

# 소스 복사 후 빌드 (테스트는 CI에서 이미 실행되므로 스킵)
COPY src ./src
COPY test ./test
RUN mvn -B package -DskipTests

# 2단계: 실행 스테이지
FROM eclipse-temurin:17-jre
WORKDIR /app

COPY --from=build /app/target/library-management-1.2.0.jar ./app.jar
COPY --from=build /app/target/lib ./lib

ENTRYPOINT ["java", "-jar", "app.jar"]